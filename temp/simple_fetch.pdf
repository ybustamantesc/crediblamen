						</div>
						<div class="app-item">
							<a href="http://localhost/lasminitas/sistema"><i class="ik ik-server"></i><span>Sistema</span></a>
						</div>
						<div class="app-item">
							<a href="http://localhost/lasminitas/formas"><i class="ik ik-clipboard"></i><span>Formas de Pago</span></a>
						</div>
						<div class="app-item">
							<a href="http://localhost/lasminitas/precios"><i class="ik ik-message-square"></i><span>Precios</span></a>
